<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17" type="device"><diagram id="ov" name="1 - Architecture Overview"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ov_title" value="&lt;b style='font-size:20px'&gt;AI-Supported Shopping List – ArchiMate Architecture View&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Components · data flows (numbered ①–⑪) · trust boundaries (red dashed, TB-1…TB-4) · data storage regions (orange, R1…R5) &amp;nbsp;|&amp;nbsp; Source: specification.md &amp;nbsp;|&amp;nbsp; v0.1, 2026-11-09&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="70" as="geometry"/></mxCell><mxCell id="ov_zA" value="&lt;font color='#C62828'&gt;TB-1&lt;/font&gt; Zone A – User device (UNTRUSTED)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2.5;dashed=1;dashPattern=10 5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="440" height="710" as="geometry"/></mxCell><mxCell id="ov_actor" value="&lt;b&gt;End User&lt;/b&gt;&lt;br&gt;(authenticated via Firebase)" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#FFFF99;shape=mxgraph.archimate3.application;appType=actor;archiType=square;fontSize=11;" vertex="1" parent="ov_zA"><mxGeometry x="100" y="50" width="220" height="70" as="geometry"/></mxCell><mxCell id="ov_dev" value="Device: Web Browser" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#AFFFAF;shape=mxgraph.archimate3.tech;techType=device;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=11;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="ov_zA"><mxGeometry x="30" y="170" width="380" height="500" as="geometry"/></mxCell><mxCell id="ov_webui" value="&lt;b&gt;Shopping List Web UI&lt;/b&gt;&lt;br&gt;SvelteKit client bundle&lt;br&gt;TypeScript · Tailwind CSS (responsive)&lt;br&gt;incl. Firebase Auth JS SDK&lt;br&gt;&lt;i&gt;AI suggestions shown with “AI” badge +&lt;br&gt;“AI may make mistakes” notice&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;fontSize=11;" vertex="1" parent="ov_dev"><mxGeometry x="30" y="60" width="320" height="190" as="geometry"/></mxCell><mxCell id="ov_R1" value="R1 – Browser storage (client device)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=1;fillColor=#FFF3E0;strokeColor=#D98A2B;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#8A4B00;" vertex="1" parent="ov_dev"><mxGeometry x="20" y="300" width="340" height="170" as="geometry"/></mxCell><mxCell id="ov_d_ai" value="&lt;b&gt;AI suggestions&lt;/b&gt;&lt;br&gt;(in-memory only, until accepted / discarded)" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.businessObject;verticalAlign=top;spacingTop=12;" vertex="1" parent="ov_R1"><mxGeometry x="10" y="50" width="155" height="95" as="geometry"/></mxCell><mxCell id="ov_d_tok" value="&lt;b&gt;Auth session&lt;/b&gt;&lt;br&gt;Firebase ID token (JWT, ~1 h) + refresh token (IndexedDB)" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.businessObject;verticalAlign=top;spacingTop=12;" vertex="1" parent="ov_R1"><mxGeometry x="175" y="50" width="155" height="95" as="geometry"/></mxCell><mxCell id="ov_zB" value="&lt;font color='#C62828'&gt;TB-2&lt;/font&gt; Zone B – Google Cloud / Firebase (3rd-party SaaS)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#EAF1FB;strokeColor=#C62828;strokeWidth=2.5;dashed=1;dashPattern=10 5;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="760" height="200" as="geometry"/></mxCell><mxCell id="ov_fbauth" value="&lt;b&gt;Firebase Authentication&lt;/b&gt;&lt;br&gt;sign-in, ID-token issuing,&lt;br&gt;public signing keys" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_zB"><mxGeometry x="40" y="50" width="300" height="90" as="geometry"/></mxCell><mxCell id="ov_R2" value="R2 – Google Cloud (Firebase project region)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=1;fillColor=#FFF3E0;strokeColor=#D98A2B;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#8A4B00;" vertex="1" parent="ov_zB"><mxGeometry x="380" y="25" width="360" height="160" as="geometry"/></mxCell><mxCell id="ov_d_users" value="&lt;b&gt;User accounts&lt;/b&gt;&lt;br&gt;uid, e-mail, credential hash / IdP link" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.businessObject;verticalAlign=top;spacingTop=12;" vertex="1" parent="ov_R2"><mxGeometry x="20" y="50" width="320" height="75" as="geometry"/></mxCell><mxCell id="ov_host" value="&lt;font color='#C62828'&gt;TB-1&lt;/font&gt; Host machine (operator-controlled) – only published ports are reachable from outside" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=3;dashed=1;dashPattern=10 5;" vertex="1" parent="1"><mxGeometry x="540" y="350" width="1780" height="1060" as="geometry"/></mxCell><mxCell id="ov_zC" value="&lt;font color='#C62828'&gt;TB-3&lt;/font&gt; Zone C – Docker Engine · Compose project (3 containers)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#F1F8F1;strokeColor=#C62828;strokeWidth=2.5;dashed=1;dashPattern=10 5;" vertex="1" parent="ov_host"><mxGeometry x="20" y="50" width="1140" height="990" as="geometry"/></mxCell><mxCell id="ov_fe" value="Container 1: frontend (Node.js) · published port" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#AFFFAF;shape=mxgraph.archimate3.tech;techType=device;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=11;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="ov_zC"><mxGeometry x="40" y="300" width="380" height="220" as="geometry"/></mxCell><mxCell id="ov_feserver" value="&lt;b&gt;SvelteKit Frontend Server&lt;/b&gt;&lt;br&gt;serves app shell &amp; assets, SSR&lt;br&gt;Impressum page" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_fe"><mxGeometry x="20" y="50" width="340" height="75" as="geometry"/></mxCell><mxCell id="ov_fecfg" value="&lt;b&gt;Config&lt;/b&gt; PUBLIC_BACKEND_URL" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.businessObject;verticalAlign=top;spacingTop=12;spacingTop=10;" vertex="1" parent="ov_fe"><mxGeometry x="20" y="155" width="340" height="45" as="geometry"/></mxCell><mxCell id="ov_be" value="Container 2: backend (Python) · published API port" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#AFFFAF;shape=mxgraph.archimate3.tech;techType=device;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=11;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="ov_zC"><mxGeometry x="460" y="40" width="640" height="550" as="geometry"/></mxCell><mxCell id="ov_api" value="&lt;b&gt;REST API (HTTPS / JSON)&lt;/b&gt; &amp;nbsp; /api/items · /api/recommendations" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=interface;archiType=square;fontSize=11;" vertex="1" parent="ov_be"><mxGeometry x="20" y="55" width="600" height="50" as="geometry"/></mxCell><mxCell id="ov_authmw" value="&lt;b&gt;Auth Middleware&lt;/b&gt;&lt;br&gt;verify Firebase ID token → uid" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="20" y="130" width="180" height="80" as="geometry"/></mxCell><mxCell id="ov_rl" value="&lt;b&gt;Per-User Rate Limiter&lt;/b&gt;&lt;br&gt;(keyed by uid)" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="230" y="130" width="180" height="80" as="geometry"/></mxCell><mxCell id="ov_fmt" value="&lt;b&gt;Response Formatter&lt;/b&gt;&lt;br&gt;uniform JSON envelope, defined error codes" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="440" y="130" width="180" height="80" as="geometry"/></mxCell><mxCell id="ov_items" value="&lt;b&gt;Item Service&lt;/b&gt;&lt;br&gt;add / list / remove, always scoped to uid" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="20" y="250" width="180" height="80" as="geometry"/></mxCell><mxCell id="ov_guard" value="&lt;b&gt;Prompt Guard&lt;/b&gt;&lt;br&gt;length limit, prompt-injection check" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="230" y="250" width="180" height="80" as="geometry"/></mxCell><mxCell id="ov_valid" value="&lt;b&gt;Response Validator &amp; Parser&lt;/b&gt;&lt;br&gt;JSON schema, max items / length" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="440" y="250" width="180" height="80" as="geometry"/></mxCell><mxCell id="ov_fscli" value="&lt;b&gt;Firestore Client&lt;/b&gt;&lt;br&gt;(Admin SDK)" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="20" y="370" width="180" height="70" as="geometry"/></mxCell><mxCell id="ov_ulog" value="&lt;b&gt;Usage Logger&lt;/b&gt;&lt;br&gt;model + tokens only" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="230" y="370" width="180" height="70" as="geometry"/></mxCell><mxCell id="ov_ocli" value="&lt;b&gt;Ollama Client&lt;/b&gt;&lt;br&gt;timeout, model from config" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_be"><mxGeometry x="440" y="370" width="180" height="70" as="geometry"/></mxCell><mxCell id="ov_becfg" value="&lt;b&gt;Config&lt;/b&gt; OLLAMA_URL, OLLAMA_MODEL, limits" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.businessObject;verticalAlign=top;spacingTop=12;" vertex="1" parent="ov_be"><mxGeometry x="440" y="465" width="180" height="70" as="geometry"/></mxCell><mxCell id="ov_zDB" value="&lt;font color='#C62828'&gt;TB-4&lt;/font&gt; Internal compose network only (no published port)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#E3F2E3;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=10 5;" vertex="1" parent="ov_zC"><mxGeometry x="460" y="630" width="420" height="340" as="geometry"/></mxCell><mxCell id="ov_db" value="Container 3: db" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#AFFFAF;shape=mxgraph.archimate3.tech;techType=device;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=11;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="ov_zDB"><mxGeometry x="15" y="45" width="200" height="190" as="geometry"/></mxCell><mxCell id="ov_fs" value="&lt;b&gt;Firestore&lt;/b&gt;&lt;br&gt;(Firebase Emulator Suite)" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=comp;archiType=square;" vertex="1" parent="ov_db"><mxGeometry x="15" y="55" width="170" height="80" as="geometry"/></mxCell><mxCell id="ov_R3" value="R3 – Docker volume “firestore-data” (host disk)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=1;fillColor=#FFF3E0;strokeColor=#D98A2B;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#8A4B00;whiteSpace=wrap;" vertex="1" parent="ov_zDB"><mxGeometry x="230" y="40" width="175" height="285" as="geometry"/></mxCell><mxCell id="ov_d_items" value="&lt;b&gt;Shopping items&lt;/b&gt;&lt;br&gt;users/{uid}/items&lt;br&gt;name, quantity,&lt;br&gt;source = manual | ai,&lt;br&gt;createdAt" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.businessObject;verticalAlign=top;spacingTop=12;" vertex="1" parent="ov_R3"><mxGeometry x="10" y="55" width="155" height="140" as="geometry"/></mxCell><mxCell id="ov_R5" value="R5 – Docker log storage (host)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=1;fillColor=#FFF3E0;strokeColor=#D98A2B;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#8A4B00;" vertex="1" parent="ov_zC"><mxGeometry x="900" y="630" width="220" height="200" as="geometry"/></mxCell><mxCell id="ov_d_log" value="&lt;b&gt;Usage log entries&lt;/b&gt;&lt;br&gt;timestamp, model, prompt / completion tokens, status&lt;br&gt;&lt;i&gt;no prompt / response by default&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.businessObject;verticalAlign=top;spacingTop=12;" vertex="1" parent="ov_R5"><mxGeometry x="10" y="45" width="200" height="130" as="geometry"/></mxCell><mxCell id="ov_n_fe" value="&lt;b&gt;Published ports&lt;/b&gt;&lt;br&gt;frontend (e.g. :3000) and backend API (e.g. :8000), TLS via reverse proxy recommended. CORS on the API allows only the frontend origin.&lt;br&gt;&lt;br&gt;&lt;b&gt;Secrets&lt;/b&gt; are never baked into images and never tracked by git (.gitignore); they are mounted read-only at runtime." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFFDE7;strokeColor=#B59F3B;" vertex="1" parent="ov_zC"><mxGeometry x="40" y="560" width="380" height="160" as="geometry"/></mxCell><mxCell id="ov_zD" value="&lt;font color='#C62828'&gt;TB-3&lt;/font&gt; Zone D – Host OS processes (outside Docker)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#F7F1FA;strokeColor=#C62828;strokeWidth=2.5;dashed=1;dashPattern=10 5;" vertex="1" parent="ov_host"><mxGeometry x="1240" y="50" width="520" height=