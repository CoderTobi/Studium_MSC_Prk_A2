242" width="150" height="22" as="geometry"/></mxCell><mxCell id="ov_lg6" value="" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#AFFFAF;shape=note;size=14;" vertex="1" parent="ov_leg"><mxGeometry x="15" y="276" width="70" height="32" as="geometry"/></mxCell><mxCell id="ov_lgt6" value="Artifact" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="95" y="282" width="150" height="22" as="geometry"/></mxCell><mxCell id="ov_lg_tb" value="" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#C62828;strokeWidth=2.5;dashed=1;dashPattern=10 5;" vertex="1" parent="ov_leg"><mxGeometry x="255" y="36" width="70" height="32" as="geometry"/></mxCell><mxCell id="ov_lgt_tb" value="Trust boundary (TB-n)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="42" width="120" height="22" as="geometry"/></mxCell><mxCell id="ov_lg_rg" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=1;fillColor=#FFF3E0;strokeColor=#D98A2B;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#8A4B00;" vertex="1" parent="ov_leg"><mxGeometry x="255" y="76" width="70" height="32" as="geometry"/></mxCell><mxCell id="ov_lgt_rg" value="Data storage region (Rn), ArchiMate «Location»" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="76" width="120" height="40" as="geometry"/></mxCell><mxCell id="ov_lge0" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;strokeWidth=2;strokeColor=#1F4E79;fontColor=#1F4E79;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1020" as="sourcePoint"/><mxPoint x="365" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ov_lget0" value="Flow (data flow, numbered)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="140" width="120" height="30" as="geometry"/></mxCell><mxCell id="ov_lge1" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1062" as="sourcePoint"/><mxPoint x="365" y="1062" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ov_lget1" value="Flow carrying untrusted data" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="182" width="120" height="30" as="geometry"/></mxCell><mxCell id="ov_lge2" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=7;dashed=1;dashPattern=1 3;strokeWidth=1.5;strokeColor=#444444;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1104" as="sourcePoint"/><mxPoint x="365" y="1104" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ov_lget2" value="Access (read / write data)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="224" width="120" height="30" as="geometry"/></mxCell><mxCell id="ov_lge3" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1146" as="sourcePoint"/><mxPoint x="365" y="1146" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ov_lget3" value="Serving" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="266" width="120" height="30" as="geometry"/></mxCell><mxCell id="ov_lge4" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1188" as="sourcePoint"/><mxPoint x="365" y="1188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ov_lget4" value="Triggering (internal call)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="308" width="120" height="30" as="geometry"/></mxCell><mxCell id="ov_lge5" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=oval;startFill=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1230" as="sourcePoint"/><mxPoint x="365" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ov_lget5" value="Assignment" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ov_leg"><mxGeometry x="335" y="350" width="120" height="30" as="geometry"/></mxCell><mxCell id="ov_lg_note" value="Circled numbers ①–⑪ refer to the data-flow table below." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;" vertex="1" parent="ov_leg"><mxGeometry x="15" y="330" width="230" height="40" as="geometry"/></mxCell><mxCell id="ov_tblh" value="&lt;b style='font-size:14px'&gt;Data flows&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="400" height="24" as="geometry"/></mxCell><mxCell id="ov_tbl" value="&lt;table style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr&gt;&lt;th style='background:#1F4E79;color:#fff;padding:3px 6px;text-align:left'&gt;#&lt;/th&gt;&lt;th style='background:#1F4E79;color:#fff;padding:3px 6px;text-align:left'&gt;From → To&lt;/th&gt;&lt;th style='background:#1F4E79;color:#fff;padding:3px 6px;text-align:left'&gt;Data&lt;/th&gt;&lt;th style='background:#1F4E79;color:#fff;padding:3px 6px;text-align:left'&gt;Protocol / channel&lt;/th&gt;&lt;th style='background:#1F4E79;color:#fff;padding:3px 6px;text-align:left'&gt;Boundary crossed&lt;/th&gt;&lt;th style='background:#1F4E79;color:#fff;padding:3px 6px;text-align:left'&gt;Controls&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;①&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;End User → Web UI&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;UI interaction (items, meal prompt, accept / discard AI suggestions)&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;local (browser)&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;–&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;AI suggestions visibly marked + “AI may make mistakes” notice&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;②&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Frontend container → Browser&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTML / JS / CSS bundle, Impressum page&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTTPS&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-1&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TLS, security headers (CSP), no secrets in bundle&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;③&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Web UI (Firebase SDK) ↔ Firebase Auth&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;credentials → ID token + refresh token&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTTPS&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-1, TB-2&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Firebase-managed; short-lived ID tokens; tokens stored in R1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;④&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Web UI → Backend REST API&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;item CRUD (JSON) or prompt; accepted AI items saved with source = ai&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTTPS, Authorization: Bearer &amp;lt;ID token&amp;gt;&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-1&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;CORS allowlist, body-size limit, token check, per-user rate limit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;⑤&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Backend → Firebase Auth&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;ID-token verification (fetch / cache Google public keys)&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTTPS (Admin SDK)&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-1, TB-2&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;service-account key from R4 secrets file; no auth → 401&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;⑥&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Backend → Firestore&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;read / write users/{uid}/items&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;gRPC / HTTP on internal compose network&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-4&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;DB port not published; every query scoped to verified uid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;⑦&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Backend → Ollama&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;fixed system prompt + checked user prompt (as data), model, format = json, output-token cap&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTTP host.docker.internal:11434&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-3&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;only backend may call; length + injection check; timeout&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;⑧&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Ollama → Backend&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;raw model output – treated as UNTRUSTED&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTTP&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-3&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;JSON parse, schema check, max items / chars, drop unknown fields; else INVALID_LLM_RESPONSE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;⑨&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Backend → Web UI&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;uniform JSON envelope {ok, data, error, meta}&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;HTTPS&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-1&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;never forwards raw model text; defined error codes (timeout, invalid prompt, …)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;⑩&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Backend → log storage (R5)&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;timestamp, model, prompt / completion tokens, status&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;stdout → Docker log driver&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;–&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;prompt / response NOT logged by default (opt-in debug flag)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;⑪&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Secrets files (R4) → Backend&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;Firebase service-account key, .env values&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;read-only bind mount&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;TB-3&lt;/td&gt;&lt;td style='padding:3px 6px;border-bottom:1px solid #ddd;vertical-align:top'&gt;gitignored, not in image, least-privilege file permissions&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="40" y="1458" width="2280" height="320" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pl" name="2 - Backend AI Request Pipeline"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pl_title" value="&lt;b style='font-size:20px'&gt;Backend – AI recommendation request pipeline&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Application process view of POST /api/recommendations · every path ends in a correctly formatted JSON envelope&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="60" as="geometry"/></mxCell><mxCell id="pl_tb3" value="&lt;font color='#C62828'&gt;&lt;b&gt;TB-3&lt;/b&gt; crossed: container → host LLM&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=10 5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="205" height="150" as="geometry"/></mxCell><mxCell id="pl_start" value="&lt;b&gt;Request received&lt;/b&gt;&lt;br&gt;POST /api/recommendations" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=event;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="80" as="geometry"/></mxCell><mxCell id="pl_s1" value="&lt;b&gt;1 Authenticate&lt;/b&gt;&lt;br&gt;verify Firebase ID token → uid" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="225" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_s2" value="&lt;b&gt;2 Rate limit&lt;/b&gt;&lt;br&gt;per-uid quota" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="435" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_s3" value="&lt;b&gt;3 Check prompt&lt;/b&gt;&lt;br&gt;max length, allowed chars, injection heuristics" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="645" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_s4" value="&lt;b&gt;4 Build LLM request&lt;/b&gt;&lt;br&gt;fixed system prompt, user text as delimited data, JSON format, token cap" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="855" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_s5" value="&lt;b&gt;5 Call Ollama&lt;/b&gt;&lt;br&gt;OLLAMA_URL / OLLAMA_MODEL, timeout" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="1065" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_s6" value="&lt;b&gt;6 Parse &amp; validate&lt;/b&gt;&lt;br&gt;JSON schema, ≤ N items, ≤ L chars, drop unknown fields" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="1275" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_s7" value="&lt;b&gt;7 Log usage&lt;/b&gt;&lt;br&gt;model, prompt / completion tokens" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="1485" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_s8" value="&lt;b&gt;8 Build success envelope&lt;/b&gt;&lt;br&gt;aiGenerated = true + disclaimer" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=proc;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="1695" y="180" width="175" height="100" as="geometry"/></mxCell><mxCell id="pl_end_ok" value="&lt;b&gt;200 OK&lt;/b&gt;&lt;br&gt;JSON response" style="html=1;outlineConnect=0;whiteSpace=wrap;fontSize=10;fillColor=#99FFFF;shape=mxgraph.archimate3.application;appType=event;archiType=rounded;" vertex="1" parent="1"><mxGeometry x="1905" y="190" width="150" height="