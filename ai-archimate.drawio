arent="1"><mxGeometry x="1180" y="550" width="160" height="70" as="geometry"/></mxCell><mxCell id="pl_c_err" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="pl_errfmt" target="pl_end_err"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="pl_j_ok" value="Success (HTTP 200)&#10;{&#10;  &quot;ok&quot;: true,&#10;  &quot;data&quot;: {&#10;    &quot;recommendations&quot;: [&#10;      { &quot;name&quot;: &quot;Spaghetti&quot;, &quot;quantity&quot;: &quot;500 g&quot; },&#10;      { &quot;name&quot;: &quot;Tomatoes&quot;,  &quot;quantity&quot;: &quot;6&quot; }&#10;    ]&#10;  },&#10;  &quot;error&quot;: null,&#10;  &quot;meta&quot;: {&#10;    &quot;aiGenerated&quot;: true,&#10;    &quot;disclaimer&quot;: &quot;AI suggestions may contain mistakes.&quot;&#10;  }&#10;}" style="shape=note;size=16;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Courier New;fillColor=#FFFDE7;strokeColor=#B59F3B;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="560" height="330" as="geometry"/></mxCell><mxCell id="pl_j_err" value="Error (e.g. HTTP 504)&#10;{&#10;  &quot;ok&quot;: false,&#10;  &quot;data&quot;: null,&#10;  &quot;error&quot;: {&#10;    &quot;code&quot;: &quot;LLM_TIMEOUT&quot;,&#10;    &quot;message&quot;: &quot;The AI did not answer in time. Please try again.&quot;&#10;  },&#10;  &quot;meta&quot;: { &quot;aiGenerated&quot;: false }&#10;}&#10;&#10;Same envelope for /api/items&#10;(e.g. 401 UNAUTHENTICATED, 404 ITEM_NOT_FOUND)." style="shape=note;size=16;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Courier New;fillColor=#FFFDE7;strokeColor=#B59F3B;" vertex="1" parent="1"><mxGeometry x="630" y="690" width="560" height="330" as="geometry"/></mxCell><mxCell id="pl_j_rules" value="Configurable limits (example defaults)&#10;PROMPT_MAX_CHARS      = 300&#10;RATE_LIMIT            = 10 prompts / min / uid&#10;LLM_TIMEOUT_SECONDS   = 30&#10;LLM_MAX_OUTPUT_TOKENS = 400&#10;MAX_RECOMMENDATIONS   = 20&#10;ITEM_NAME_MAX_CHARS   = 60&#10;LOG_PROMPTS           = false&#10;&#10;Prompt-injection checks (step 3)&#10;- reject role markers / &quot;ignore previous instructions&quot;&#10;- reject control characters, markup, code fences&#10;- user text passed only as a delimited data field&#10;&#10;Output handling (step 6)&#10;- strict JSON parse, schema validated&#10;- strip unknown keys, trim + dedupe names&#10;- anything else -&gt; INVALID_LLM_RESPONSE" style="shape=note;size=16;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Courier New;fillColor=#FFFDE7;strokeColor=#B59F3B;" vertex="1" parent="1"><mxGeometry x="1220" y="690" width="600" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>