# Copy to .env and adjust. .env is gitignored, never commit real values.

# --- Authentication -------------------------------------------------------------
# true = debug mode: Firebase ID tokens are NOT verified. The uid is read from the
# token without checking the signature; without a token the user is "debug-user".
# NEVER use in production. Real token verification is not implemented yet, so the
# backend currently refuses to start unless this is true.
AUTH_DISABLED=true

# --- Firestore ------------------------------------------------------------------
# Path to the service account key file (keep it in backend/secrets/, gitignored).
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json
# Optional: defaults to the project of the service account key.
# GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Optional: name of the Firestore database.
FIRESTORE_DATABASE=(default)
# Optional: use the Firestore emulator instead of the real database.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- HTTP -----------------------------------------------------------------------
# Comma-separated list of frontend origins allowed via CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Maximum request body size in bytes.
MAX_BODY_BYTES=16384

# --- Limits ---------------------------------------------------------------------
# Maximum number of items on a user's shopping list.
ITEM_LIMIT=200
# Maximum prompt length in characters (after trimming).
PROMPT_MAX_LENGTH=500
# Requests per user and minute: all authenticated endpoints / POST /recommendations.
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10

# --- Ollama ---------------------------------------------------------------------
# Ollama runs on the host OS, outside of Docker. Only the backend talks to it.
# Inside a container (dev container, Docker, Compose) the host is reachable as
# host.docker.internal; when running the backend directly on the host, use
# http://localhost:11434. Ollama must listen on an address the container can reach
# (e.g. OLLAMA_HOST=0.0.0.0 on the host).
OLLAMA_URL=http://host.docker.internal:11434
# Model to use. It must be pulled on the host first: ollama pull <model>
OLLAMA_MODEL=llama3.2
# Server-side timeout for one model call in seconds (AI_TIMEOUT when exceeded).
OLLAMA_TIMEOUT_SECONDS=30
# Maximum number of tokens the model may generate per call. Thinking models count
# their thinking tokens too; if the limit is hit, the answer is cut off and the
# request fails with AI_INVALID_RESPONSE (logged as done_reason=length).
OLLAMA_MAX_OUTPUT_TOKENS=2048
# Thinking of thinking models (e.g. qwen3, gemma4): false = answer without thinking
# (much faster, far fewer tokens), true = force thinking. Leave empty to use the
# model's default.
OLLAMA_THINK=

# --- Logging --------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Prompts and model responses are never
# logged; each model call logs the model and its token usage.
LOG_LEVEL=INFO
