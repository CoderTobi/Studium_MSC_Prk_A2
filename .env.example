# Deployment settings for Docker Compose (compose.yaml). Copy to .env and adjust.
# All values are optional; the defaults work when everything runs on localhost.
# Backend and frontend options live in backend/.env and frontend/.env.

# Host ports the containers are published on.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# URLs as the BROWSER sees them. On a home server, use its host name or IP, for example
# http://homeserver:3000 and http://homeserver:8000. They must match each other:
# FRONTEND_ORIGIN is allowed via CORS by the backend, BACKEND_URL is what the frontend
# calls (without /api/v1).
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Ollama on the host OS, as seen from the backend container.
OLLAMA_URL=http://host.docker.internal:11434

# Firestore service account key on the host.
FIREBASE_SERVICE_ACCOUNT_FILE=./backend/secrets/firebase-service-account.json
