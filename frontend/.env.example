# Copy to .env and adjust. .env is gitignored.
# These values are read when the server starts, not at build time.

# Base URL of the backend, WITHOUT /api/v1.
PUBLIC_BACKEND_URL=http://localhost:8000

# How users sign in.
#   firebase = Firebase Authentication with email and password. Users can also create
#              an account. Needs PUBLIC_FIREBASE_API_KEY and a backend running with
#              AUTH_DISABLED=false for the same Firebase project.
#   debug    = no real authentication: you enter any username and the frontend sends an
#              unsigned token. Only works with a backend running with AUTH_DISABLED=true.
#              NEVER use in production.
PUBLIC_AUTH_MODE=firebase

# Web API key of the Firebase project (Firebase console > Project settings > General >
# Your apps > Web app > apiKey). Required for PUBLIC_AUTH_MODE=firebase. The
# "Email/Password" sign-in provider must be enabled in the project.
PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
