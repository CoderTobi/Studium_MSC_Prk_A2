# Copy to .env and adjust. .env is gitignored.
# These values are read when the server starts, not at build time.

# Base URL of the backend, WITHOUT /api/v1.
PUBLIC_BACKEND_URL=http://localhost:8000

# How users sign in.
#   debug = no real authentication: you enter any username and the frontend sends an
#           unsigned token. Only works with a backend running with AUTH_DISABLED=true.
#           NEVER use in production.
# "firebase" will be added together with Firebase Authentication.
PUBLIC_AUTH_MODE=debug
