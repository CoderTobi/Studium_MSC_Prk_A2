// Single dev container for the whole project (FastAPI backend + SvelteKit frontend).
// This is the development environment only; the 2-container deliverable is defined
// separately via compose.yaml and the Dockerfiles in backend/ and frontend/.
{
  "name": "AI Shopping List",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },

  // Ollama runs on the host OS, reachable from here at http://host.docker.internal:11434
  // (Docker Desktop provides this name already; the flag makes it work on plain Linux Docker too).
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)" },
    "8000": { "label": "Backend (FastAPI)" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "42crunch.vscode-openapi",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  },

  "remoteUser": "vscode"
}
